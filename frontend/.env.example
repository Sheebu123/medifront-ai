# ==============================================================================
# MediFront AI — Frontend Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development. Never commit .env.local.
# For Vercel production deployment, configure these variables in project settings.

# 1. Supabase Authentication
# The Supabase Project URL and Public Anon / Publishable key used for client authentication.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# 2. FastAPI Backend
# Client-accessible base URL for the FastAPI backend API.
# Local development: http://127.0.0.1:8000
# Production: https://your-backend-service.onrender.com
NEXT_PUBLIC_FASTAPI_BASE_URL=http://127.0.0.1:8000

# Optional server-to-server URL for Next.js Server Components.
# Defaults to NEXT_PUBLIC_FASTAPI_BASE_URL if omitted.
# FASTAPI_BASE_URL=http://127.0.0.1:8000
