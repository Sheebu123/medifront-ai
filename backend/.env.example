# ==============================================================================
# MediFront AI — Backend Environment Configuration
# ==============================================================================
# Copy this file to .env for local development. Never commit .env.
# For Render production deployment, configure these variables in the environment settings.

# 1. CORS Configuration
# Comma-separated list of allowed frontend browser origins.
# Local development: http://localhost:3000,http://127.0.0.1:3000
# Production: https://your-medifront-frontend.vercel.app
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# 2. Neon PostgreSQL Database
# Pooled connection string used for high-concurrency API traffic.
DATABASE_URL=postgresql://user:password@your-neon-host-pooler/your_database?sslmode=require
# Direct (unpooled) connection string required for Alembic schema migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@your-neon-host/your_database?sslmode=require

# 3. Supabase Auth Token Verification
# Used exclusively to verify bearer tokens via the Supabase Auth /auth/v1/user endpoint.
# Use the publishable or anon key; NEVER supply a service-role or secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
