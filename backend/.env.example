# Local frontend origin allowed by the backend CORS policy.
FRONTEND_ORIGIN=http://localhost:3000

# Neon PostgreSQL connection string (use the pooled URL for API traffic).
DATABASE_URL=postgresql://user:password@your-neon-host-pooler/your_database?sslmode=require
# Direct URL required for Alembic migrations (do not use the pooled hostname).
DATABASE_URL_UNPOOLED=postgresql://user:password@your-neon-host/your_database?sslmode=require

# Copy these values from the Supabase project configuration / frontend environment.
# Use a publishable key (or legacy anon key), never a service-role or secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
