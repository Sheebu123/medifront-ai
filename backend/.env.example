# Local frontend origin allowed by the backend CORS policy.
FRONTEND_ORIGIN=http://localhost:3000

# Copy these values from the Supabase project configuration / frontend environment.
# Use a publishable key (or legacy anon key), never a service-role or secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
